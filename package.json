{
  "name": "flowboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:units && npm run lint:code",
    "lint:code": "eslint .",
    "lint:units": "node scripts/check-units.mjs",
    "typecheck": "tsc -b",
    "test": "TZ=Asia/Kolkata vitest --run",
    "test:watch": "TZ=Asia/Kolkata vitest",
    "coverage": "TZ=Asia/Kolkata vitest --run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@headlessui/react": "2.2.10",
    "@rehookify/datepicker": "6.6.8",
    "immer": "11.1.21",
    "lucide-react": "1.57.0",
    "nanoid": "6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "clsx": "2.1.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.2",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
