{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — mirrors the `@` alias in vite.config.ts.
       Declared without `baseUrl`, which is deprecated in TypeScript 6. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Strictness — Requirement 21.16 */
    "strict": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    /* Normalized Record<id, entity> lookups genuinely can miss. Forcing the
       undefined case surfaces that instead of letting it crash at runtime. */
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
